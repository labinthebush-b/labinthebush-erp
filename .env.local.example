# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings → API in the Supabase dashboard). Never commit
# .env.local — it's already gitignored.
#
# IMPORTANT — see ENVIRONMENTS.md: .env.local is for LOCAL DEVELOPMENT.
# Point it at the DEV Supabase project, never at production. There is no
# code-level guard against pointing it at production — this file is the
# guard, so double-check the URL below before running `npm run dev`.

# Marks this build as non-production — controls the "DEV" badge in the app
# header (src/components/layout/environment-badge.tsx). Leave unset/blank
# for local dev and Preview deployments; only Vercel's Production
# environment should set this to "production".
NEXT_PUBLIC_APP_ENV=development

# Public — safe to expose to the browser (protected by Row Level Security,
# not by secrecy). Project Settings → API → Project URL / anon public key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Server-only — NEVER prefix with NEXT_PUBLIC_, never import from a "use
# client" file. Bypasses Row Level Security entirely. Used only by
# scripts/seed-dev-data.ts to seed a LOCAL/DEV project; not read by the app
# itself at runtime. Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
